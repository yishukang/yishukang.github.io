---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Hero from "@/components/Hero.astro";
import ServicesPanel from "@/components/ServicesPanel.astro";
import ExperienceTimeline from "@/components/ExperienceTimeline.astro";
import { getCollection } from "astro:content";
import { getLangFromUrl, pathFor, useTranslations } from "@/i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const allWork = await getCollection("work", ({ id }) => !id.startsWith("_"));
const featured = allWork.filter((item) => item.data.featured).slice(0, 3);
const categories = [
  { href: `${pathFor(lang, "/work")}#xiaohongshu`, label: t.work.xiaohongshu, detail: t.work.xiaohongshuIntro },
  { href: `${pathFor(lang, "/work")}#posters`, label: t.work.posters, detail: t.work.postersIntro },
  { href: `${pathFor(lang, "/work")}#events`, label: t.work.events, detail: t.work.eventsIntro }
];
---

<BaseLayout title={t.nav.home}>
  <Hero lang={lang} />

  <section class="section-tight rule">
    <div class="wrap category-entry">
      <div>
        <h2 class="section-title">{t.home.categoriesTitle}</h2>
        <p>{t.home.categoriesIntro}</p>
      </div>
      <div class="category-list">
        {categories.map((category) => (
          <a href={category.href}>
            <span>{category.label}</span>
            <small>{category.detail}</small>
          </a>
        ))}
      </div>
    </div>
  </section>

  <ServicesPanel lang={lang} />
  <ExperienceTimeline lang={lang} />

  <section class="section rule">
    <div class="wrap featured-strip">
      {featured.map((item, index) => {
        const title = lang === "zh" ? item.data.title_zh : item.data.title_en;
        const href = item.data.detailPath ? pathFor(lang, item.data.detailPath) : pathFor(lang, "/work");

        return (
          <article class="featured-card">
            <div class="featured-media" style={`aspect-ratio: ${item.data.aspect};`}>
              {item.data.video ? (
                <video controls preload="metadata" playsinline aria-label={title}>
                  <source src={item.data.video} type="video/mp4" />
                </video>
              ) : item.data.image ? (
                <a href={href} aria-label={title}>
                  <img src={item.data.image} alt={title} loading="lazy" />
                </a>
              ) : (
                <a href={href} class="featured-placeholder-link" aria-label={title}>
                  <div class="media-placeholder">
                    <span>{item.data.category.toUpperCase()} · {String(index + 1).padStart(2, "0")}</span>
                  </div>
                </a>
              )}
            </div>
            <h3><a href={href}>{title}</a></h3>
          </article>
        );
      })}
    </div>
  </section>

  <section class="section rule">
    <div class="wrap split home-about">
      <div>
        <h2 class="section-title">{t.home.aboutTitle}</h2>
      </div>
      <div class="prose">
        <p>{t.home.aboutText}</p>
        <a class="arrow-link" href={pathFor(lang, "/about")}>{t.home.aboutLink}</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .category-entry {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(20rem, 1fr);
    gap: clamp(2rem, 6vw, 6rem);
  }

  .category-entry p {
    max-width: 34rem;
    margin: 1rem 0 0;
    color: var(--muted);
  }

  .category-list {
    display: grid;
    border-top: 1px solid var(--line);
  }

  .category-list a {
    display: grid;
    grid-template-columns: minmax(10rem, 0.8fr) 1fr;
    gap: 1rem;
    padding-block: 1.15rem;
    border-bottom: 1px solid var(--line);
  }

  .category-list span {
    font-family: var(--serif);
    font-size: clamp(1.35rem, 2.5vw, 2rem);
  }

  .category-list small {
    color: var(--muted);
    font-size: 0.9rem;
  }

  .category-list a:hover span {
    color: var(--accent);
  }

  .featured-strip {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1rem, 3vw, 2.5rem);
    align-items: start;
  }

  .featured-card {
    display: grid;
    gap: 1rem;
  }

  .featured-media {
    overflow: hidden;
    background: var(--surface);
  }

  .featured-media a {
    display: block;
    width: 100%;
    height: 100%;
  }

  .featured-media img,
  .featured-media video,
  .featured-media :global(.media-placeholder) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .featured-media img,
  .featured-media :global(.media-placeholder) {
    transition: transform 300ms ease;
  }

  .featured-card:hover .featured-media img,
  .featured-card:hover .featured-media :global(.media-placeholder) {
    transform: scale(1.025);
  }

  .featured-card:nth-child(2) {
    margin-top: clamp(2rem, 5vw, 5rem);
  }

  .featured-card h3 {
    margin: 0;
    font-family: var(--serif);
    font-size: clamp(1.4rem, 2.4vw, 2rem);
    font-weight: 500;
  }

  .home-about {
    align-items: center;
  }

  @media (max-width: 820px) {
    .category-entry,
    .category-list a,
    .featured-strip {
      grid-template-columns: 1fr;
    }

    .featured-card:nth-child(2) {
      margin-top: 0;
    }
  }

  @media (max-width: 560px) {
    .category-list a {
      gap: 0.25rem;
      padding-block: 1rem;
    }

    .featured-strip {
      gap: 2.25rem;
    }

    .featured-card h3 {
      font-size: 1.45rem;
    }
  }
</style>
