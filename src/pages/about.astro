---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ExperienceTimeline from "@/components/ExperienceTimeline.astro";
import { getLangFromUrl, useTranslations } from "@/i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<BaseLayout title={t.nav.about}>
  <section class="section">
    <div class="wrap page-intro">
      <h1 class="page-title">{t.about.title}</h1>
      <p>{t.about.lead}</p>
    </div>
  </section>

  <section class="section-tight rule">
    <div class="wrap about-grid">
      <div class="portrait-placeholder about-portrait portrait-frame" aria-label={t.about.portrait}>
        <img
          src="/images/portrait/hero.jpg"
          alt="Yishu Kang portrait"
          loading="lazy"
          onerror="this.hidden = true"
        />
        <span>{t.about.portrait}</span>
      </div>
      <div class="prose about-copy">
        <p>{t.about.bodyOne}</p>
        <p>{t.about.bodyTwo}</p>
      </div>
    </div>
  </section>

  <ExperienceTimeline lang={lang} />

  <section class="section rule">
    <div class="wrap capability-grid">
      <h2 class="section-title">{t.about.capabilitiesTitle}</h2>
      <ul>
        {t.about.capabilities.map((item) => <li>{item}</li>)}
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .page-intro {
    display: grid;
    gap: 2rem;
  }

  .page-intro p {
    max-width: 44rem;
    margin: 0;
    color: var(--muted);
    font-size: clamp(1.2rem, 2.4vw, 1.65rem);
  }

  .about-grid {
    display: grid;
    grid-template-columns: minmax(18rem, 0.8fr) minmax(0, 1fr);
    gap: clamp(2rem, 6vw, 6rem);
    align-items: center;
  }

  .about-portrait {
    aspect-ratio: 4 / 5;
  }

  .portrait-frame {
    position: relative;
  }

  .portrait-frame img {
    position: absolute;
    inset: 0;
    z-index: 2;
    width: 100%;
    height: 100%;
    object-fit: cover;
    background: var(--surface);
  }

  .portrait-frame img[src="/images/portrait/hero.jpg"] {
    color: transparent;
  }

  .about-copy {
    padding-block: 2rem;
  }

  .capability-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(18rem, 1fr);
    gap: clamp(2rem, 6vw, 6rem);
    align-items: start;
  }

  ul {
    display: grid;
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: caps;
  }

  li {
    counter-increment: caps;
    display: grid;
    grid-template-columns: 3rem 1fr;
    gap: 1.5rem;
    align-items: center;
    padding-block: 1rem;
    border-bottom: 1px solid var(--line);
    color: var(--ink);
    font-family: var(--serif);
    font-size: clamp(1.25rem, 2.5vw, 2rem);
    line-height: 1.25;
  }

  li::before {
    content: counter(caps, decimal-leading-zero);
    color: var(--accent);
    font-family: var(--sans);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
  }

  @media (max-width: 820px) {
    .about-grid,
    .capability-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 560px) {
    .page-intro {
      gap: 1.15rem;
    }

    .page-intro p {
      font-size: 1rem;
    }

    .about-copy {
      padding-block: 0;
    }

    li {
      grid-template-columns: 2.35rem 1fr;
      gap: 1rem;
      font-size: 1.2rem;
    }
  }
</style>
