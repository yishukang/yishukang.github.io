---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ContactIcon from "@/components/ContactIcon.astro";
import { getLangFromUrl, useTranslations } from "@/i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<BaseLayout title={t.nav.contact}>
  <section class="contact-page">
    <div class="wrap contact-grid">
      <div>
        <h1 class="page-title">{t.contact.title}</h1>
        <p>{t.contact.intro}</p>
      </div>
      <div class="contact-panel">
        <div class="contact-line">
          <p class="meta"><ContactIcon name="mail" />{t.contact.emailLabel}</p>
          <a class="mail-link" href={`mailto:${t.contact.email}`}>{t.contact.email}</a>
        </div>
        <div class="contact-line">
          <p class="meta"><ContactIcon name="phone" />{t.contact.phoneLabel}</p>
          <a class="phone-link" href={`tel:${t.contact.phone.replaceAll(" ", "")}`}>{t.contact.phone}</a>
        </div>
        <div class="socials">
          <p class="meta">{t.contact.socialLabel}</p>
          <a href={t.contact.linkedinUrl} rel="noreferrer">
            <ContactIcon name="linkedin" />{t.contact.linkedin}
          </a>
          <a href={t.contact.xiaohongshuUrl} rel="noreferrer">
            <ContactIcon name="xiaohongshu" />{t.contact.xiaohongshu}
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .contact-page {
    min-height: calc(100svh - 10rem);
    display: grid;
    align-items: center;
    padding-block: clamp(4rem, 9vw, 9rem);
  }

  .contact-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(18rem, 0.72fr);
    gap: clamp(2rem, 7vw, 7rem);
    align-items: end;
  }

  .contact-grid .page-title {
    max-width: 8ch;
    font-size: 5.75rem;
    line-height: 1.02;
  }

  .contact-grid > div:first-child p {
    max-width: 36rem;
    margin: 1.5rem 0 0;
    color: var(--muted);
    font-size: 1.25rem;
  }

  .contact-panel {
    display: grid;
    gap: 2rem;
    padding-top: 2rem;
    border-top: 1px solid var(--line);
  }

  .contact-line {
    display: grid;
    gap: 0.55rem;
  }

  .contact-line .meta,
  .socials .meta {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
  }

  .mail-link,
  .phone-link {
    color: var(--ink);
    font-family: var(--serif);
    font-size: 2.35rem;
    line-height: 1.05;
    overflow-wrap: anywhere;
  }

  .mail-link {
    overflow-wrap: anywhere;
  }

  .mail-link:hover,
  .phone-link:hover,
  .socials a:hover {
    color: var(--accent);
  }

  .socials {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem 1.25rem;
  }

  .socials a {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    min-height: 2rem;
  }

  .socials .meta {
    flex-basis: 100%;
    margin: 0;
  }

  @media (max-width: 1000px) {
    .contact-grid .page-title {
      font-size: 4.5rem;
    }

    .mail-link,
    .phone-link {
      font-size: 1.85rem;
    }
  }

  @media (max-width: 820px) {
    .contact-page {
      min-height: auto;
      align-items: start;
      padding-block: 3.25rem;
    }

    .contact-grid {
      grid-template-columns: 1fr;
      align-items: start;
      gap: 2.5rem;
    }
  }

  @media (max-width: 560px) {
    .contact-grid .page-title {
      max-width: 10ch;
      font-size: 2.75rem;
    }

    .contact-grid > div:first-child p {
      font-size: 1rem;
    }

    .mail-link,
    .phone-link {
      font-size: clamp(1.05rem, 5.1vw, 1.32rem);
    }

    .contact-panel {
      gap: 1.55rem;
      padding-top: 1.5rem;
    }
  }
</style>
