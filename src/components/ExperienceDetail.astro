---
import BaseLayout from "@/layouts/BaseLayout.astro";
import type { Lang } from "@/i18n/ui";
import { pathFor, useTranslations } from "@/i18n/utils";

interface Props {
  lang: Lang;
  caseKey: "byd" | "haier";
}

const { lang, caseKey } = Astro.props;
const t = useTranslations(lang);
const project = t.caseStudies[caseKey];
---

<BaseLayout title={project.title} description={project.intro}>
  <section class="section case-hero">
    <div class="wrap case-hero-grid">
      <div>
        <p class="meta">{project.date} · {project.role}</p>
        <h1 class="page-title">{project.title}</h1>
      </div>
      <div class="case-intro">
        <p>{project.intro}</p>
        <a class="arrow-link" href={pathFor(lang, "/about")}>{t.caseStudies.backToAbout}</a>
      </div>
    </div>
  </section>

  <section class="section-tight rule">
    <div class="wrap case-overview">
      <div class="case-fact">
        <span>{project.client}</span>
      </div>
      <div class="case-copy">
        <h2>{t.caseStudies.overview}</h2>
        <p>{project.overview}</p>
      </div>
    </div>
  </section>

  <section class="section rule">
    <div class="wrap case-body">
      <div>
        <h2 class="section-title case-section-title">{t.caseStudies.contribution}</h2>
      </div>
      <ol class="contribution-list">
        {project.contributions.map((item) => <li>{item}</li>)}
      </ol>
    </div>
  </section>

  <section class="section rule">
    <div class="wrap image-section">
      <p>{t.caseStudies.imageNote}</p>
      <div class="case-images">
        {project.images.map((image, index) => (
          <div class="media-placeholder case-image" aria-label={image.label}>
            <img src={image.src} alt={image.label} loading="lazy" onerror="this.hidden = true" />
            <span>{image.label} · {String(index + 1).padStart(2, "0")}</span>
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .case-hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(18rem, 0.56fr);
    gap: clamp(2rem, 6vw, 6rem);
    align-items: end;
  }

  .case-hero .meta {
    margin: 0 0 1.25rem;
  }

  .case-intro {
    display: grid;
    gap: 1.5rem;
    justify-items: start;
  }

  .case-intro p {
    margin: 0;
    color: var(--muted);
    font-size: clamp(1.05rem, 2vw, 1.35rem);
  }

  .case-overview {
    display: grid;
    grid-template-columns: minmax(12rem, 0.55fr) minmax(0, 1fr);
    gap: clamp(2rem, 6vw, 6rem);
  }

  .case-body {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(1.5rem, 4vw, 2.75rem);
  }

  .case-body > div {
    min-width: 0;
  }

  .case-section-title {
    max-width: none;
    font-size: clamp(2.1rem, 5vw, 4.25rem);
    line-height: 1.05;
    text-wrap: balance;
  }

  .case-fact {
    display: flex;
    align-items: flex-start;
  }

  .case-fact span {
    padding-top: 0.25rem;
    border-top: 2px solid var(--accent);
    color: var(--ink);
    font-size: 0.78rem;
    font-weight: 650;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .case-copy {
    max-width: 46rem;
  }

  .case-copy h2 {
    margin: 0;
    font-family: var(--serif);
    font-size: clamp(1.75rem, 3vw, 3rem);
    font-weight: 500;
    line-height: 1.1;
  }

  .case-copy p {
    margin: 1rem 0 0;
    color: var(--muted);
    font-size: clamp(1.05rem, 2vw, 1.28rem);
  }

  .contribution-list {
    display: grid;
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: contribution;
    border-top: 1px solid var(--line);
  }

  .contribution-list li {
    counter-increment: contribution;
    display: grid;
    grid-template-columns: 3rem minmax(0, 1fr);
    gap: clamp(1rem, 3vw, 2rem);
    align-items: center;
    padding-block: clamp(1rem, 2.5vw, 1.6rem);
    border-bottom: 1px solid var(--line);
    color: var(--ink);
    font-family: var(--serif);
    font-size: clamp(1.2rem, 2.2vw, 1.8rem);
    line-height: 1.25;
  }

  .contribution-list li::before {
    content: counter(contribution, decimal-leading-zero);
    color: var(--accent);
    font-family: var(--sans);
    font-size: 0.72rem;
    font-weight: 650;
    letter-spacing: 0.1em;
  }

  .image-section {
    display: grid;
    gap: 1.5rem;
  }

  .image-section p {
    max-width: 34rem;
    margin: 0;
    color: var(--muted);
  }

  .case-images {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1rem, 3vw, 2rem);
  }

  .case-image {
    aspect-ratio: 16 / 10;
    min-height: 0;
  }

  .case-image img {
    position: absolute;
    inset: 0;
    z-index: 2;
    width: 100%;
    height: 100%;
    object-fit: cover;
    background: var(--surface);
  }

  @media (max-width: 820px) {
    .case-hero-grid,
    .case-overview,
    .case-body,
    .case-images {
      grid-template-columns: 1fr;
    }

    .case-hero-grid {
      align-items: start;
    }
  }

  @media (max-width: 560px) {
    .case-hero .page-title {
      font-size: clamp(2.75rem, 14vw, 4rem);
    }

    .contribution-list li {
      grid-template-columns: 2.35rem minmax(0, 1fr);
      gap: 1rem;
      font-size: 1.1rem;
    }
  }
</style>
