---
import type { Lang } from "@/i18n/ui";
import { useTranslations } from "@/i18n/utils";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const services = [t.services.marketing, t.services.events, t.services.content];
---

<section class="section rule services-panel">
  <div class="wrap services-grid">
    <div>
      <h2 class="section-title">{t.services.title}</h2>
      <p>{t.services.intro}</p>
    </div>
    <div class="service-list">
      {services.map((service, index) => (
        <article>
          <span>{String(index + 1).padStart(2, "0")}</span>
          <h3>{service.title}</h3>
          <p>{service.text}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .services-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.82fr) minmax(20rem, 1fr);
    gap: clamp(2rem, 6vw, 6rem);
    align-items: start;
  }

  .services-grid > div:first-child p {
    max-width: 32rem;
    margin: 1rem 0 0;
    color: var(--muted);
  }

  .service-list {
    display: grid;
    border-top: 1px solid var(--line);
  }

  article {
    display: grid;
    grid-template-columns: 3rem minmax(8rem, 0.6fr) 1fr;
    gap: 1rem;
    align-items: center;
    padding-block: 1.1rem;
    border-bottom: 1px solid var(--line);
  }

  span {
    color: var(--accent);
    font-size: 0.75rem;
    font-weight: 650;
    letter-spacing: 0.1em;
  }

  h3,
  p {
    margin: 0;
  }

  h3 {
    font-family: var(--serif);
    font-size: clamp(1.2rem, 2vw, 1.65rem);
    font-weight: 500;
    line-height: 1.15;
  }

  p {
    color: var(--muted);
    font-size: 0.95rem;
  }

  @media (max-width: 820px) {
    .services-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 620px) {
    article {
      grid-template-columns: 2.25rem 1fr;
      align-items: start;
    }

    article p {
      grid-column: 2;
    }
  }
</style>
