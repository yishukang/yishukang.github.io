---
import { type Lang } from "@/i18n/ui";
import { pathFor, useTranslations } from "@/i18n/utils";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="hero wrap">
  <div class="hero-copy">
    <h1 class="display-title">{t.hero.title}</h1>
    <div class="hero-intro">
      <p class="role">{t.hero.role}</p>
      <p>{t.hero.intro}</p>
      <a class="arrow-link" href={pathFor(lang, "/work")}>{t.hero.cta}</a>
    </div>
  </div>
  <div class="hero-media portrait-placeholder portrait-frame" aria-label={t.hero.portrait}>
    <img
      src="/images/portrait/hero.jpg"
      alt="Yishu Kang portrait"
      loading="eager"
      onerror="this.hidden = true"
    />
    <span>{t.hero.portrait}</span>
  </div>
</section>

<style>
  .hero {
    min-height: calc(100vh - 4.75rem);
    display: grid;
    grid-template-columns: minmax(0, 0.96fr) minmax(20rem, 0.82fr);
    gap: clamp(1.5rem, 5vw, 5rem);
    align-items: center;
    padding-block: clamp(3rem, 6vw, 7rem);
  }

  .hero-copy {
    display: grid;
    gap: clamp(1.75rem, 4vw, 4rem);
  }

  .hero-intro {
    max-width: 25rem;
    padding-left: clamp(0rem, 1vw, 0.5rem);
  }

  .hero-intro p {
    margin: 0 0 1rem;
  }

  .role {
    color: var(--ink);
    font-weight: 600;
  }

  .hero-media {
    aspect-ratio: 4 / 5;
    min-height: 32rem;
  }

  .portrait-frame {
    position: relative;
  }

  .portrait-frame img {
    position: absolute;
    inset: 0;
    z-index: 2;
    width: 100%;
    height: 100%;
    object-fit: cover;
    background: var(--surface);
  }

  .portrait-frame img[src="/images/portrait/hero.jpg"] {
    color: transparent;
  }

  .portrait-frame img:not([src]),
  .portrait-frame img[src=""] {
    display: none;
  }

  .portrait-frame img::selection {
    background: transparent;
  }

  @media (max-width: 900px) {
    .hero {
      min-height: auto;
      grid-template-columns: 1fr;
      padding-top: 2.5rem;
    }

    .hero-media {
      min-height: 24rem;
    }
  }

  @media (max-width: 560px) {
    .hero {
      gap: 2rem;
      padding-block: 2.25rem 3rem;
    }

    .hero-copy {
      gap: 1.25rem;
    }

    .hero-intro {
      max-width: 100%;
      padding-left: 0;
    }

    .hero-media {
      min-height: auto;
      aspect-ratio: 4 / 4.8;
    }
  }
</style>
