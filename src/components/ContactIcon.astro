---
interface Props {
  name: "mail" | "phone" | "linkedin" | "xiaohongshu";
}

const { name } = Astro.props;
---

{
  name === "mail" && (
    <svg aria-hidden="true" viewBox="0 0 24 24" class="contact-icon">
      <rect x="3.5" y="5.5" width="17" height="13" rx="1.8"></rect>
      <path d="m4.25 7.25 7.75 6.1 7.75-6.1"></path>
    </svg>
  )
}
{
  name === "phone" && (
    <svg aria-hidden="true" viewBox="0 0 24 24" class="contact-icon">
      <path d="M7.4 4.6 5.6 6.35c-.72.72-.65 2.6.24 4.84.9 2.25 2.62 4.72 4.66 6.3 2.04 1.57 4.18 2.12 5.15 1.62l2.28-1.2-2.6-3.6-2.12 1.04c-.42.2-1.56-.28-2.72-1.43-1.16-1.14-2.04-2.54-2.12-3.06l-.09-.55 1.9-1.53L7.4 4.6Z"></path>
    </svg>
  )
}
{
  name === "linkedin" && (
    <svg aria-hidden="true" viewBox="0 0 24 24" class="contact-icon">
      <rect x="4" y="4" width="16" height="16" rx="2"></rect>
      <path d="M8.2 10.3v5.7"></path>
      <path d="M11.5 16v-3.05c0-1.5.82-2.55 2.15-2.55 1.18 0 1.95.82 1.95 2.45V16"></path>
      <path d="M8.2 7.9h.01"></path>
    </svg>
  )
}
{
  name === "xiaohongshu" && (
    <svg aria-hidden="true" viewBox="0 0 24 24" class="contact-icon">
      <path d="M6.75 4.5h8.6L19 8.15v11.35H6.75a1.75 1.75 0 0 1-1.75-1.75V6.25A1.75 1.75 0 0 1 6.75 4.5Z"></path>
      <path d="M15.35 4.65v3.5H18.8"></path>
      <path d="M8.25 11h7.5"></path>
      <path d="M8.25 14h6"></path>
      <path d="M8.25 17h4.1"></path>
    </svg>
  )
}

<style>
  .contact-icon {
    width: 1.15rem;
    height: 1.15rem;
    flex: 0 0 auto;
    color: currentColor;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.55;
  }
</style>
