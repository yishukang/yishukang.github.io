---
import type { CollectionEntry } from "astro:content";
import type { Lang } from "@/i18n/ui";
import { pathFor } from "@/i18n/utils";

interface Props {
  item: CollectionEntry<"work">;
  lang: Lang;
  index: number;
}

const { item, lang, index } = Astro.props;
const data = item.data;
const title = lang === "zh" ? data.title_zh : data.title_en;
const description = lang === "zh" ? data.description_zh : data.description_en;
const sourceLabel = lang === "zh" ? "查看报道" : "View coverage";
const detailHref = data.detailPath ? pathFor(lang, data.detailPath) : undefined;
const categoryLabel =
  lang === "zh"
    ? {
        xiaohongshu: "小红书",
        poster: "海报",
        event: "活动"
      }[data.category]
    : {
        xiaohongshu: "REDNOTE",
        poster: "POSTER",
        event: "EVENT"
      }[data.category];
const padded = String(index + 1).padStart(2, "0");
---

<article class={`work-card work-card-${data.category}`}>
  <div class="work-media" style={`--aspect: ${data.aspect};`}>
    {
      detailHref ? (
        <a class="work-media-link" href={detailHref} aria-label={title}>
          {data.image ? (
            <img src={data.image} alt={title} loading="lazy" />
          ) : (
            <div class="media-placeholder">
              <span>{categoryLabel} · {padded}</span>
            </div>
          )}
        </a>
      ) : data.image ? (
        <img src={data.image} alt={title} loading="lazy" />
      ) : (
        <div class="media-placeholder">
          <span>{categoryLabel} · {padded}</span>
        </div>
      )
    }
  </div>
  <div class="work-copy">
    <p class="meta">{categoryLabel} · {new Date(data.date).getFullYear()}</p>
    <h3>
      {detailHref ? <a href={detailHref}>{title}</a> : title}
    </h3>
    <p>{description}</p>
    {
      data.externalUrl && (
        <a class="work-source" href={data.externalUrl} target="_blank" rel="noreferrer">
          {sourceLabel}
        </a>
      )
    }
  </div>
</article>

<style>
  .work-card {
    display: grid;
    gap: 1rem;
  }

  .work-media {
    aspect-ratio: var(--aspect);
    overflow: hidden;
    background: var(--surface);
  }

  .work-media-link {
    display: block;
    width: 100%;
    height: 100%;
  }

  .work-media :global(img),
  .work-media :global(.media-placeholder) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 300ms ease, filter 300ms ease;
  }

  .work-card:hover .work-media :global(img),
  .work-card:hover .work-media :global(.media-placeholder) {
    transform: scale(1.025);
  }

  .work-copy {
    display: grid;
    gap: 0.35rem;
  }

  .work-copy h3,
  .work-copy p {
    margin: 0;
  }

  .work-copy h3 {
    font-family: var(--serif);
    font-size: clamp(1.25rem, 2.2vw, 1.75rem);
    font-weight: 500;
    line-height: 1.15;
  }

  .work-copy p:not(.meta) {
    color: var(--muted);
    font-size: 0.95rem;
  }

  .work-source {
    width: fit-content;
    margin-top: 0.25rem;
    border-bottom: 1px solid var(--accent);
    color: var(--accent);
    font-size: 0.72rem;
    font-weight: 650;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
</style>
