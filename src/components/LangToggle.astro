---
import { languages, type Lang } from "@/i18n/ui";
import { localizePath } from "@/i18n/utils";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const otherLang = lang === "en" ? "zh" : "en";
const href = localizePath(Astro.url.pathname, otherLang);
---

<a class="lang-toggle" href={href} aria-label={`Switch to ${languages[otherLang]}`}>
  <span aria-hidden="true">{lang.toUpperCase()}</span>
  <span>{languages[otherLang]}</span>
</a>

<style>
  .lang-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.4rem;
    color: var(--muted);
    font-size: 0.72rem;
    font-weight: 650;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .lang-toggle span:last-child {
    color: var(--accent);
  }

  .lang-toggle:hover {
    color: var(--ink);
  }
</style>
